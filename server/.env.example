# ============================
# AI Recruitment Platform — Environment Variables
# ============================
# Copy this to .env and fill in your values

# Server
PORT=5000
NODE_ENV=development

# MongoDB Atlas
MONGODB_URI=mongodb+srv://<user>:<password>@cluster.mongodb.net/recruitment_ai?retryWrites=true&w=majority

# JWT
JWT_SECRET=your_super_secret_jwt_key_change_this
JWT_EXPIRES_IN=7d

# ============================
# AI Provider Configuration (LangChain orchestrated)
# LLM:        gemini (default) | openai | groq
# Embeddings: gemini (default) | jina   | voyage | openai | auto
# ============================
AI_PROVIDER=gemini
EMBEDDING_PROVIDER=gemini

# Google Gemini 2.5 Flash (primary LLM + gemini-embedding-001)
GEMINI_API_KEY=your_gemini_api_key_here

# Jina AI Embeddings (EMBEDDING_PROVIDER=jina)
JINA_API_KEY=your_jina_api_key_here
JINA_MODEL=jina-embeddings-v3

# Voyage AI Embeddings (EMBEDDING_PROVIDER=voyage)
VOYAGE_API_KEY=your_voyage_api_key_here

# OpenAI (optional — used when AI_PROVIDER=openai or as embedding fallback)
OPENAI_API_KEY=your_openai_api_key_here

# Groq (optional — used when AI_PROVIDER=groq)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# ============================
# Resume Parsing
# LlamaParse provides cloud-quality PDF/DOCX extraction.
# Leave blank or omit to fall back to local pdf-parse/mammoth.
# ============================
LLAMAPARSE_API_KEY=your_llamaparse_api_key_here

# ============================
# Cloudinary (required for POST /api/resumes/upload)
# ============================
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ============================
# Google OAuth (for social login)
# ============================
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALLBACK_URL=http://localhost:5000/api/auth/google/callback

# Client URL (for CORS & redirects)
CLIENT_URL=http://localhost:5173
